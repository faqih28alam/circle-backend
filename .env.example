# This is .env example

# Local postgrsql DB
# DATABASE_URL="postgresql://[USERNAME]:[PASSWORD]@localhost:5432/[DTABASE-NAME]?schema=public"
# Neon postgrsql DB
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Application Port
PORT = [PORT-NUMBER]
# JWT Secret
JWT_SECRET = [Anything Custom Separate with "-"]